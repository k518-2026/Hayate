<Window x:Class="Hayate.CompletionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hayate — 完了"
        SizeToContent="Height" Width="470"
        ResizeMode="NoResize" ShowInTaskbar="True" Topmost="True"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg}">

    <Border Padding="22" Background="{StaticResource Panel}" CornerRadius="8" Margin="10">
        <StackPanel>
            <TextBlock x:Name="HeadlineText" FontSize="19" FontWeight="Bold"
                       Foreground="{StaticResource Ok}" Margin="0,0,0,4"/>
            <TextBlock x:Name="SubText" Style="{StaticResource Caption}" Margin="0,0,0,16"
                       TextWrapping="Wrap"/>

            <Grid x:Name="StatsGrid" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="経過時間" Style="{StaticResource Caption}"/>
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="ElapsedValue" FontWeight="SemiBold"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="転送量" Style="{StaticResource Caption}"/>
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="BytesValue"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="平均速度" Style="{StaticResource Caption}"/>
                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="SpeedValue"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="件数" Style="{StaticResource Caption}"/>
                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="CountValue"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="失敗" Style="{StaticResource Caption}"/>
                <TextBlock Grid.Row="4" Grid.Column="1" x:Name="FailedValue"/>
            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button x:Name="OpenFolderButton" Content="コピー先を開く" Click="OpenFolder_Click"/>
                <Button Content="閉じる" Style="{StaticResource PrimaryButton}" MinWidth="92"
                        IsDefault="True" IsCancel="True" Click="Close_Click" Margin="0"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
